{
  "name": "ecase-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"node server.js\" \"vite --host 0.0.0.0 --port 5173\" \"vite --host 0.0.0.0 --port 5174\" \"vite --host 0.0.0.0 --port 13000\"",
    "build": "vite build",
    "start": "node server.js",
    "start:ports": "concurrently --kill-others-on-fail \"node server.js\" \"vite preview --host 0.0.0.0 --port 5173\" \"vite preview --host 0.0.0.0 --port 5174\" \"vite preview --host 0.0.0.0 --port 13000\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
